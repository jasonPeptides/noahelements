# Shopify Storefront API — local secrets (gitignored, never commit).
SHOPIFY_STORE_DOMAIN=noah-elements.myshopify.com
SHOPIFY_API_VERSION=2024-01

# Storefront API — Headless channel PUBLIC access token (X-Shopify-Storefront-Access-Token).
SHOPIFY_STOREFRONT_TOKEN=005e819897b043428bad71a94e7861b4

# Optional private (server-side) token — shpat_… via Shopify-Storefront-Private-Token. Blank = unused.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Custom app credentials — server exchanges these (client-credentials grant) for
# an Admin token, then mints/reuses a Storefront access token automatically.
SHOPIFY_CLIENT_ID=89c48e24746a24751b761ab5d9cb9f70
SHOPIFY_CLIENT_SECRET=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

# askTIAN BaZi API (server-side only)
ASKTIAN_API_KEY=at_live_2b6925595fc16c313d79a3e60edc0b227057b0188ba8d95f554f49f1d8f1360a
